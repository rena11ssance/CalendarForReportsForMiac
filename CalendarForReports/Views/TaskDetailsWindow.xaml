<Window x:Class="CalendarForReports.Views.TaskDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали задачи" Height="450" Width="450"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="18" FontWeight="Bold" 
                   Text="Название задачи" Margin="0,0,0,15" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1" x:Name="KeyText" FontSize="12" Foreground="Gray" 
                   Text="Ключ: " Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" x:Name="RecurrenceText" FontSize="12" 
                   Text="Периодичность: " Margin="0,0,0,5"/>

        <TextBlock Grid.Row="3" x:Name="TimeText" FontSize="12" 
                   Text="Время запуска: " Margin="0,0,0,5"/>

        <TextBlock Grid.Row="4" x:Name="NextRunText" FontSize="12" 
                   Text="Следующий запуск: " Margin="0,0,0,15"/>

        <TextBlock Grid.Row="5" Text="Описание:" FontWeight="Bold" Margin="0,0,0,5"/>
        <Border Grid.Row="6" BorderBrush="#E0E0E0" BorderThickness="1" 
                CornerRadius="4" Padding="10" Background="#F9F9F9">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" 
                           Text="Описание отсутствует."/>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="7" Content="Закрыть" Width="100" Height="32" 
                HorizontalAlignment="Right" Margin="0,15,0,0" Click="Close_Click"/>
    </Grid>
</Window>